{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorant-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // database_id を書かなければ、初回デプロイ時に wrangler が D1 を自動作成する
  "d1_databases": [{ "binding": "DB", "database_name": "valorant-stats" }],
  // 分析用の保管庫。バケットが無ければ、デプロイ時に wrangler がこの名前で作成する（R2 を有効にしてあること）
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "valorant-stats-archive" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // 追跡する Riot ID（カンマ区切りで複数可）
    "RIOT_IDS": "cinder#qshen,Thou Shalt Die#srymb,Cadd9th#chord,タピオカに課税#TAX,GoodLuckHaveFun#SRYMB,Sorrymybad#GLHF,ashen#713,蜈ｨ驛ｨ菫ｺ縺梧が縺#閾ｪ雋ｬ",
    "REGION": "ap",
    "PLATFORM": "pc"
  },
  "observability": { "enabled": true }
}
